# Export these in your shell or configure them in your JVM host.
# Spring Boot does not load .env files automatically.
PORT=4000
DATABASE_URL=jdbc:sqlite:server/data/veloura.db
CLIENT_ORIGIN=http://localhost:4000
VELOURA_PRODUCTION=true
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
