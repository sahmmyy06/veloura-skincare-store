# Optional custom settings: copy to .env.docker and pass --env-file .env.docker.
# Do not commit the private file. Docker Compose reads it, not Spring itself.
HOST_PORT_RANGE=4000-4099
VELOURA_PRODUCTION=false
CLIENT_ORIGIN=http://localhost:4000
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# For a public deployment, use VELOURA_PRODUCTION=true, your HTTPS CLIENT_ORIGIN,
# real credentials, and an HTTPS reverse proxy in front of the container.
